local ZyroX = {}

function ZyroX:Create(title)
	local gui = Instance.new("ScreenGui", game.CoreGui)
	gui.Name = "ZyroX_UI"

	local main = Instance.new("Frame")
	main.Size = UDim2.new(0, 300, 0, 400)
	main.Position = UDim2.new(0.5, -150, 0.5, -200)
	main.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
	main.BorderSizePixel = 0
	main.Parent = gui

	local header = Instance.new("TextLabel")
	header.Size = UDim2.new(1, 0, 0, 30)
	header.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
	header.Text = title or "ZyroX Hub"
	header.TextColor3 = Color3.new(1,1,1)
	header.TextSize = 18
	header.Font = Enum.Font.SourceSansBold
	header.Parent = main

	local close = Instance.new("TextButton")
	close.Size = UDim2.new(0, 30, 0, 30)
	close.Position = UDim2.new(1, -30, 0, 0)
	close.BackgroundColor3 = Color3.fromRGB(60, 0, 0)
	close.Text = "X"
	close.TextColor3 = Color3.new(1,1,1)
	close.TextSize = 18
	close.Font = Enum.Font.SourceSansBold
	close.Parent = header

	close.MouseButton1Click:Connect(function()
		gui:Destroy()
	end)

	local content = Instance.new("Frame")
	content.Size = UDim2.new(1, 0, 1, -30)
	content.Position = UDim2.new(0, 0, 0, 30)
	content.BackgroundTransparency = 1
	content.Parent = main

	local layout = Instance.new("UIListLayout", content)
	layout.Padding = UDim.new(0, 5)

	local window = {}

	function window:AddButton(text, callback)
		local button = Instance.new("TextButton")
		button.Size = UDim2.new(1, -10, 0, 30)
		button.Position = UDim2.new(0, 5, 0, 0)
		button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
		button.TextColor3 = Color3.new(1, 1, 1)
		button.TextSize = 16
		button.Font = Enum.Font.SourceSansBold
		button.BorderSizePixel = 0
		button.Text = text
		button.Parent = content
		button.MouseButton1Click:Connect(function()
			if callback then callback() end
		end)
	end

	function window:AddToggle(text)
		local toggle = Instance.new("TextButton")
		toggle.Size = UDim2.new(1, -10, 0, 30)
		toggle.Position = UDim2.new(0, 5, 0, 0)
		toggle.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
		toggle.TextColor3 = Color3.new(1, 1, 1)
		toggle.TextSize = 16
		toggle.Font = Enum.Font.SourceSansBold
		toggle.BorderSizePixel = 0
		toggle.Text = text
		toggle.Parent = content

		local state = false

		toggle.MouseButton1Click:Connect(function()
			state = not state
			if state then
				toggle.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
			else
				toggle.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
			end
		end)
	end

	return window
end

return ZyroX
